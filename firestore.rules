rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isBot() {
      return request.auth != null && request.auth.token.email == 'n8nbot@leadinbox.app';
    }

    // Check if user is admin or in allowed members list in /config/team
    function isAuthorizedTeamMember() {
      let teamDoc = get(/databases/$(database)/documents/config/team);
      let email = request.auth.token.email.lower();
      return isSignedIn() && (
        email == teamDoc.data.adminEmail ||
        email in teamDoc.data.members
      );
    }

    function isAdmin() {
      let teamDoc = get(/databases/$(database)/documents/config/team);
      let email = request.auth.token.email.lower();
      return isSignedIn() && email == teamDoc.data.adminEmail;
    }

    // 1. Shared Leads Collection
    match /sharedLeads/{leadId} {
      allow read, create, update: if isBot() || isAuthorizedTeamMember();
      allow delete: if isAdmin() || isBot();
    }

    // 2. Team Config Document
    match /config/team {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        resource == null || 
        request.auth.token.email.lower() == resource.data.adminEmail
      );
    }

    // 3. User Connected Pages (for n8n & pages)
    match /users/{userId}/pages/{pageId} {
      allow read, write: if isBot() || isSignedIn();
    }

    match /pageOwners/{pageId} {
      allow read, write: if isBot() || isSignedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
