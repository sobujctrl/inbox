rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && request.auth.token.email.lower() == 'sobujbd679@gmail.com';
    }
    
    function isBot() {
      return isSignedIn() && (request.auth.token.email.lower() == 'n8nbot@leadinbox.app' || request.auth.token.firebase.sign_in_provider == 'custom');
    }

    function isAuthorizedTeamMember() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/config/team) && (
          request.auth.token.email.lower() in get(/databases/$(database)/documents/config/team).data.memberEmails ||
          request.auth.token.email.lower() == get(/databases/$(database)/documents/config/team).data.adminEmail.lower()
        ))
      );
    }

    // 2. sharedLeads collection: Read & Write for Admin, Authorized Team Members, or n8n Bot
    // Delete is strictly restricted to Admin (or Bot)
    match /sharedLeads/{leadId} {
      allow read, create, update: if isAuthorizedTeamMember() || isBot();
      allow delete: if isAdmin() || isBot();
    }

    // 3. config/team: Read for signed-in users (to verify permissions), Write only for Admin
    match /config/team {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 4. pageOwners: Facebook Webhook & n8n mapping
    match /pageOwners/{pageId} {
      allow read, write: if isSignedIn() || isBot();
    }

    // 5. Legacy & per-user collections
    match /users/{userId}/{document=**} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isBot());
    }

    match /teamMembers/{memberEmail} {
      allow read, write: if isSignedIn();
    }

    // Default deny for unmatched collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
